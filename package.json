{
  "name": "san-realworld-app",
  "version": "0.1.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && webpack --config=webpack.config.js --mode=production",
    "start": "NODE_OPTIONS=--openssl-legacy-provider webpack serve --config=webpack.config.js --mode=development",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testMatch": [
      "**/test/**/*.test.(ts|tsx|js)",
      "**/test/**/*.spec.(ts|tsx|js)"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.js$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{js,ts,tsx}",
      "!src/**/*.d.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecomfe/san-realworld-app.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ecomfe/san-realworld-app/issues"
  },
  "dependencies": {
    "axios": "^0.19.0",
    "core-js": "^3.48.0",
    "date-fns": "^1.30.1",
    "http-server": "^14.1.1",
    "marked": "^0.6.2",
    "san": "^3.15.5",
    "san-router": "^2.0.3",
    "san-store": "^2.2.8",
    "san-update": "2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@types/axios": "^0.9.36",
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^25.1.0",
    "babel-loader": "^9.0.0",
    "css-loader": "^7.0.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.0.0",
    "jest": "^24.8.0",
    "mini-css-extract-plugin": "^2.10.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^24.3.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^5.0.0"
  },
  "homepage": "https://github.com/ecomfe/san-realworld-app#readme"
}
